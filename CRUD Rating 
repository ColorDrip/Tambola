from flask import Flask, request, jsonify, render_template_string
import pyodbc
import os
import webbrowser
import threading
from datetime import datetime

app = Flask(__name__)

# ========== CONFIG ==========
# Change this path to point to your Access .accdb file
ACCESS_DB_PATH = r"C:\Users\Public\ratings_portal.accdb"

# Connection string
CONN_STR = fr"DRIVER={{Microsoft Access Driver (*.mdb, *.accdb)}};DBQ={ACCESS_DB_PATH};"

# ========== SINGLE-PAGE HTML (embedded) ==========
HTML_PAGE = """
<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>Ratings Portal</title>
  <style>
    body{font-family:Arial;margin:24px;}
    .tabs{display:flex;gap:8px;margin-bottom:12px;}
    .tabs button{padding:8px 12px;cursor:pointer;}
    .tabs button.active{background:#2b7cff;color:#fff;border:none;border-radius:4px;}
    .container{border:1px solid #ddd;padding:16px;border-radius:6px;}
    .question{margin:12px 0;padding:8px;border-bottom:1px solid #f0f0f0;}
    .param{font-weight:600;}
    .desc{font-size:0.95em;color:#333;margin:6px 0;}
    select, textarea, input[type=text]{width:100%;padding:8px;margin-top:6px;border:1px solid #ccc;border-radius:4px;}
    textarea{min-height:60px;resize:vertical;}
    .submit{background:#28a745;color:#fff;padding:10px 14px;border:none;border-radius:4px;cursor:pointer;margin-top:10px;}
    .small{font-size:0.9em;color:#666;}
  </style>
</head>
<body>
  <h2>Ratings Portal</h2>
  <div>
    <label>Submitter Name:</label>
    <input id="submitter" type="text" placeholder="Enter your name">
  </div>

  <div class="tabs" id="tabs"></div>

  <div id="content" class="container">
    <p class="small">Select a tab to load its parameters...</p>
  </div>

<script>
async function loadTabs() {
  const res = await fetch('/get_tabs');
  const data = await res.json();
  const tabs = document.getElementById('tabs');
  tabs.innerHTML = '';
  data.tabs.forEach((t, i) => {
    const btn = document.createElement('button');
    btn.textContent = t;
    btn.dataset.tab = t;
    btn.onclick = () => openTab(t, btn);
    if (i===0) btn.classList.add('active');
    tabs.appendChild(btn);
  });
  // open first active tab automatically if any
  if (data.tabs.length) openTab(data.tabs[0], tabs.querySelector('button'));
}

async function openTab(tabName, btn) {
  // mark active
  document.querySelectorAll('.tabs button').forEach(b=>b.classList.remove('active'));
  if (btn) btn.classList.add('active');

  // fetch questions
  const res = await fetch('/get_questions?tab=' + encodeURIComponent(tabName));
  const payload = await res.json();
  const content = document.getElementById('content');

  if (!payload.questions || payload.questions.length===0) {
    content.innerHTML = '<p class="small">No parameters found for this tab.</p>';
    return;
  }

  // Build UI: for each question show Parameter (label), Description (from DB), Dropdown (1..10) and comments
  let html = `<h3>${tabName}</h3>
              <p class="small">Each parameter has a rating dropdown (1-10) and a comment box.</p>
              <div id="questions-area">`;
  payload.questions.forEach(q => {
    html += `
      <div class="question" data-qno="${q.QuestionNo}">
        <div class="param">${q.QuestionNo}. ${q.Parameter}</div>
        <div class="desc">${q.Description || ''}</div>
        <label>Rating:</label>
        <select id="rating_${q.QuestionNo}">
          <option value="">-- Select rating --</option>
          ${Array.from({length:10}, (_,i)=>\`<option value="\${i+1}">\${i+1}</option>\`).join('')}
        </select>
        <label>Comments (optional):</label>
        <textarea id="comment_${q.QuestionNo}" placeholder="Add comments for ${q.Parameter}"></textarea>
      </div>`;
  });
  html += `</div><button class="submit" onclick="submit('${tabName}')">Submit Ratings</button>
           <div id="status" style="margin-top:10px"></div>`;

  content.innerHTML = html;
}

async function submit(tabName) {
  const submitter = document.getElementById('submitter').value.trim();
  if (!submitter) { alert('Please enter your name before submitting.'); return; }

  const qs = Array.from(document.querySelectorAll('#questions-area .question'));
  const answers = qs.map(div => {
    const qno = parseInt(div.dataset.qno, 10);
    const rating = document.getElementById('rating_' + qno).value;
    const comment = document.getElementById('comment_' + qno).value;
    return { QuestionNo: qno, Rating: rating ? parseInt(rating,10) : None, Comments: comment };
  });

  // build payload only for answered ratings
  const payload = {
    tab: tabName,
    submitter,
    answers: answers.filter(a=>a.Rating)  // only save where rating selected
  };

  if (payload.answers.length === 0) {
    if (!confirm('No ratings selected. Do you want to submit empty responses?')) return;
  }

  document.getElementById('status').textContent = 'Saving...';

  const res = await fetch('/save_ratings', {
    method: 'POST',
    headers: {'Content-Type':'application/json'},
    body: JSON.stringify(payload)
  });
  const r = await res.json();
  if (r.success) {
    document.getElementById('status').textContent = '✅ Saved successfully.';
    // optional: clear selections
    qs.forEach(div=>{
      const qno = div.dataset.qno;
      document.getElementById('rating_' + qno).value = '';
      document.getElementById('comment_' + qno).value = '';
    });
  } else {
    document.getElementById('status').textContent = '❌ Error: ' + r.error;
  }
}

window.addEventListener('DOMContentLoaded', loadTabs);
</script>
</body>
</html>
"""

# ========== Helper to get DB connection ==========
def get_conn():
    return pyodbc.connect(CONN_STR)

# ========== Routes ==========
@app.route("/")
def index():
    return render_template_string(HTML_PAGE)

@app.route("/get_tabs")
def get_tabs():
    try:
        conn = get_conn()
        cur = conn.cursor()
        # Expect TabsAccess(TabName Text, IsActive Yes/No)
        cur.execute("SELECT TabName FROM TabsAccess WHERE IsActive = True ORDER BY TabName")
        rows = cur.fetchall()
        tabs = [r.TabName for r in rows]
        conn.close()
        return jsonify({"tabs": tabs})
    except Exception as e:
        # return empty if any issue (caller will show placeholder)
        return jsonify({"tabs": [], "error": str(e)})

@app.route("/get_questions")
def get_questions():
    tab = request.args.get('tab') or ''
    try:
        conn = get_conn()
        cur = conn.cursor()
        # Expect Questions(TabName Text, QuestionNo Number, Parameter Text, Description Memo)
        cur.execute("SELECT QuestionNo, Parameter, Description FROM Questions WHERE TabName = ? ORDER BY QuestionNo", (tab,))
        rows = cur.fetchall()
        questions = []
        for r in rows:
            questions.append({
                "QuestionNo": int(r.QuestionNo),
                "Parameter": r.Parameter,
                "Description": r.Description or ""
            })
        conn.close()
        return jsonify({"questions": questions})
    except Exception as e:
        return jsonify({"questions": [], "error": str(e)})

@app.route("/save_ratings", methods=["POST"])
def save_ratings():
    try:
        data = request.get_json()
        tab = data.get("tab")
        submitter = data.get("submitter") or data.get("manager") or "Unknown"
        answers = data.get("answers", [])

        conn = get_conn()
        cur = conn.cursor()
        for a in answers:
            qno = a.get("QuestionNo")
            rating = a.get("Rating")
            comments = a.get("Comments") or ""
            submitted_at = datetime.now()
            # Ratings(TabName, QuestionNo, Manager, RatingValue, Comments, SubmittedAt)
            cur.execute("""
                INSERT INTO Ratings (TabName, QuestionNo, Manager, RatingValue, Comments, SubmittedAt)
                VALUES (?, ?, ?, ?, ?, ?)
            """, (tab, qno, submitter, rating, comments, submitted_at))
        conn.commit()
        conn.close()
        return jsonify({"success": True})
    except Exception as e:
        return jsonify({"success": False, "error": str(e)})

# Auto-open browser when app starts
def open_browser():
    webbrowser.open_new("http://127.0.0.1:5000/")

if __name__ == "__main__":
    # quick sanity: check DB path exists and warn (but still run)
    if not os.path.exists(ACCESS_DB_PATH):
        print("WARNING: Access DB not found at:", ACCESS_DB_PATH)
        print("Please create DB and tables (TabsAccess, Questions, Ratings) as described.")
    threading.Timer(1.2, open_browser).start()
    app.run(debug=True)