    def load_data(self):
        """Load data from Excel files with error handling"""
        try:
            self.faqs = pd.read_excel(self.faq_path)
            if os.path.exists(self.log_path):
                self.logs = pd.read_excel(self.log_path)
            else:
                self.logs = pd.DataFrame()
            print(f"📊 Loaded {len(self.faqs)} FAQs from database")
        except Exception as e:
            print(f"⛔ Error loading data files: {str(e)}")
            raise SystemExit("Exiting due to data loading error")
    
    def initialize_vectorizer(self):
        """Initialize the TF-IDF vectorizer with error handling"""
        try:
            self.vectorizer = TfidfVectorizer(
                tokenizer=self.nltk_tokenizer,
                ngram_range=(1, 2),
                stop_words=list(self.stop_words)
            )
            self.question_vectors = self.vectorizer.fit_transform(self.faqs['Question'])
            print("🔠 Vectorizer initialized with unigrams and bigrams")
        except Exception as e:
            print(f"⛔ Error initializing vectorizer: {str(e)}")
            print("⚠️ Using simple text matching as fallback")
            # Fallback to simple vectorizer
            self.vectorizer = TfidfVectorizer()
            self.question_vectors = self.vectorizer.fit_transform(self.faqs['Question'])
    
    def nltk_tokenizer(self, text):
        """Custom tokenizer using NLTK with error handling"""
        try:
            text = re.sub(r'[^\w\s]', '', text.lower())
            tokens = word_tokenize(text)
            filtered_tokens = [
                self.lemmatizer.lemmatize(token) 
                for token in tokens 
                if token not in self.stop_words and len(token) > 2
            ]
            ngrams = list(everygrams(filtered_tokens, max_len=2))
            return ['_'.join(gram) for gram in ngrams]
        except:
            # Fallback tokenization if NLTK fails
            return text.lower().split()
    
    def process_query(self, query):
        """Process a user query and return a response with error handling"""
        try:
            # Find best match
            match, confidence = self.find_best_match(query)
            
            if match is not None:
                # Update usage stats
                self.update_faq_usage(match.name)
                
                # Format response
                response = {
                    'type': 'answer',
                    'confidence': f"{confidence:.0%}",
                    'question': match['Question'],
                    'answer': match['Answer'],
                    'category': match['Category'],
                    'count': match['Use Count']
                }
            else:
                # Generate fallback response
                response = {
                    'type': 'fallback',
                    'response': self.generate_fallback_response(query)
                }
            
            # Log the conversation
            self.log_conversation(query, response)
            return response
        except Exception as e:
            print(f"⚠️ Error processing query: {str(e)}")
            return {
                'type': 'error',
                'response': "I encountered an error processing your request. Please try again."
            }
    
    def find_best_match(self, query):
        """Find best match using TF-IDF with n-grams"""
        try:
            query_vec = self.vectorizer.transform([query])
            similarities = cosine_similarity(query_vec, self.question_vectors)
            max_index = np.argmax(similarities)
            max_similarity = similarities[0, max_index]
            
            if max_similarity > 0.3:
                return self.faqs.iloc[max_index], max_similarity
            return None, max_similarity
        except:
            # Fallback matching if vectorizer fails
            query_lower = query.lower()
            for idx, row in self.faqs.iterrows():
                if query_lower in row['Question'].lower():
                    return row, 0.9
            return None, 0
    
    def update_faq_usage(self, index):
        """Update usage statistics for a FAQ entry"""
        try:
            self.faqs.at[index, 'Use Count'] += 1
            self.faqs.at[index, 'Last Used'] = datetime.now()
            self.faqs.to_excel(self.faq_path, index=False)
        except Exception as e:
            print(f"⚠️ Error updating FAQ usage: {str(e)}")
    
    def generate_fallback_response(self, query):
        """Generate fallback response for unknown queries"""
        try:
            # Extract keywords
            keywords = self.extract_keywords(query)
            
            # Find related questions
            related_questions = []
            for _, row in self.faqs.iterrows():
                faq_tokens = set(self.nltk_tokenizer(row['Question']))
                if keywords & faq_tokens:
                    related_questions.append(row['Question'])
            
            # Format response
            if related_questions:
                response = "I couldn't find an exact match, but these might help:\n"
                for i, q in enumerate(set(related_questions[:3]), 1):
                    response += f"{i}. {q}\n"
            else:
                top_questions = self.faqs.sort_values('Use Count', ascending=False)['Question'].head(3).tolist()
                response = "I'm not sure about that. Try these popular questions:\n"
                for i, q in enumerate(top_questions, 1):
                    response += f"{i}. {q}\n"
            
            return response
        except:
            return "I'm not sure how to answer that. Could you try rephrasing your question?"
    
    def extract_keywords(self, text):
        """Extract keywords from text"""
        try:
            tokens = self.nltk_tokenizer(text)
            return set(tokens)
        except:
            return set(text.lower().split())
    
    def log_conversation(self, user_input, response):
        """Record conversation to Excel log with error handling"""
        try:
            log_entry = {
                'Timestamp': datetime.now(),
                'User Input': user_input,
                'System Response': response['answer'] if response['type'] == 'answer' else response['response'],
                'Matched Question': response.get('question', ''),
                'Confidence': response.get('confidence', '')
            }
            
            log_df = pd.DataFrame([log_entry])
            
            # Append to existing log or create new
            if os.path.exists(self.log_path):
                existing_log = pd.read_excel(self.log_path)
                updated_log = pd.concat([existing_log, log_df], ignore_index=True)
            else:
                updated_log = log_df
            
            updated_log.to_excel(self.log_path, index=False)
        except Exception as e:
            print(f"⚠️ Error logging conversation: {str(e)}")

